# Copy to .env and fill in secrets. Do not commit .env.
# Mode A (default): prometheus — metrics in Prometheus, logs/traces in ClickHouse
# Mode B: clickhouse_only — metrics, logs, and traces in ClickHouse
STORAGE_MODE=prometheus
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme
LLM_PROVIDER=
LLM_API_KEY=
# Prometheus UI port — only relevant if using docker-compose.prometheus-ui.yml
PROMETHEUS_PORT=9090
ENABLE_SIGNOZ=false
SIGNOZ_PORT=8080
